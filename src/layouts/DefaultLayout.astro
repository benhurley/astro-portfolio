---
import '../styles/fonts.css'
import '../styles/brand/tokens.css'
import '../styles/brand/base.css'
import '../styles/site.css'
import SiteMeta from '../components/SiteMeta.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const {
  title = 'Ben Ventures',
  description = `Is Your Website Stuck in 2010? Let's Rescue It. Reach out to Ben today to fix your website or build a new one.`,
  url = Astro.url.pathname,
  image = '/og-image.png',
  author = 'Ben',
} = Astro.props
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* Apply a saved theme before first paint so the page doesn't flash (docs/brand/WEB.md §2) */
      ;(function () {
        var t = null
        try {
          t = localStorage.getItem('bv-theme')
        } catch (e) {}
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      })()
    </script>
    <link rel="preload" href="/fonts/jost-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- favicons, manifest, theme colour (brand kit favicon/head-snippet.html) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F4F1EA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#231F20" media="(prefers-color-scheme: dark)" />

    <SiteMeta title={title} description={description.substring(0, 100)} url={url} image={image} author={author} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
