---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import SocialShares from '@components/SocialShares.astro'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const projects = await getCollection('projects')

  return projects
    .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
    .map((project) => ({
      params: { project: project.id.replace(/\.mdx?$/, '') },
      props: { project },
    }))
}

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { Content } = await render(project)

// Generate lightbox modals for project images dynamically
const projectImageCount = 4 // Or detect this dynamically if needed
const projectImages = Array.from({ length: projectImageCount }, (_, i) => ({
  id: `img${i + 1}`,
  src: `/projects/${project.id}/project-image-${i + 1}.png`,
  alt: `Project image ${i + 1}`,
}))
---

<DefaultLayout title={project.data.title} description={project.data.description} url={`/portfolio/${project.id}/`}>
  <PageHeader
    title={project.data.title}
    subtitle={project.data.description}
    meta={`Made with ${project.data.platform}`}
    featuredImage={`/projects/${project.id}/banner.png`}
  />

  <!-- Lightboxes for the gallery images (opened with #imgN links). Kept before the sections so the last
       section stays main's last child and gets the kit's closing padding. -->
  {
    projectImages.map((image) => (
      <div id={image.id} class="lightbox">
        <a href="#_" class="lightbox__close">
          Close
        </a>
        <img src={image.src} alt={image.alt} loading="lazy" />
      </div>
    ))
  }
  <section class="section">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="prose">
        <h2>Share this project</h2>
        <SocialShares text={project.data.title} />
      </div>
    </div>
  </section>
</DefaultLayout>
