---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import ContentMedia from '@components/ContentMedia.astro'

const offerings = [
  {
    title: 'Development',
    text: 'Clean, fast, and accessible code from a product engineer trusted by companies of all sizes.',
  },
  {
    title: 'UX',
    text: 'Simplify your website and remove friction so visitors can find what they need instantly.',
  },
  {
    title: 'Design',
    text: 'Wireframes, mockups, and design systems crafted for your unique brand identity.',
  },
  {
    title: 'Starting a new company?',
    text: "Let me handle the technical setup while you focus on your business. I'll get you up and running with a domain, landing page, company email, and everything else you need to start collecting customers from day one.",
  },
  {
    title: 'Need advising?',
    text: "New projects are overwhelming, and it helps to have someone who's been there. I'll ensure your design system, brand kit, and source code are built on a foundation for growth and consistency.",
  },
]
---

<DefaultLayout title="Ben Ventures">
  <Hero />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">01 · offerings</span>
        <h2>What I do</h2>
      </div>
      <ul class="grid">
        {
          offerings.map((offering, index) => (
            <li>
              <div class="card">
                <span class="eyebrow">{String(index + 1).padStart(2, '0')}</span>
                <h3>{offering.title}</h3>
                <p class="muted">{offering.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">02 · guiding principle</span>
      <h2 class="principle"><mark>Instinctive</mark> design</h2>
      <p class="lead">Every product is unique and every interaction is intuitive.</p>
    </div>
  </section>

  <ContentMedia imgSrc="/projects/exposure-tracker/project-image-5.png">
    <span class="eyebrow">03 · latest release</span>
    <h2>Exposure Tracker</h2>
    <p class="lead">
      A cross-platform application built for firefighters and first responders to securely document exposures,
      incidents, and long-term health risks.
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/portfolio/exposure-tracker/">View case study</a>
    </div>
  </ContentMedia>

  <FeaturedProjects eyebrow="04 · work" />

  <section class="section">
    <div class="container">
      <span class="eyebrow">05 · contact</span>
      <h2>Let's get to work.</h2>
      <p class="lead">Tell me about your project and I'll get back to you.</p>
      <div class="btn-row">
        <a
          class="btn btn--accent"
          href="mailto:ben@benvent.com?subject=Project%20Inquiry&body=Hi%20Ben%2C%0A%0AI%27d%20like%20to%20discuss%20a%20project.%20Here%27s%20what%20I%27m%20looking%20for%3A%0A%0A"
          >Email Ben</a
        >
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .principle {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
</style>
