---
import DefaultLayout from '@layouts/DefaultLayout.astro'
---

<DefaultLayout title="Page not found">
  <section class="hero">
    <div class="container">
      <span class="eyebrow">404 · not found</span>
      <h1>You seem lost. Everything okay?</h1>
      <p class="lead">The page you're looking for isn't here. It may have moved, or the link may be wrong.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Let's get you back home</a>
      </div>
    </div>
  </section>
</DefaultLayout>
