---
import { Image } from 'astro:assets'
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import headshot from '@assets/images/headshot.jpg'

const expertise = [
  'Frontend development for web, iOS and Android',
  'UX and product design',
  'Design systems and brand kits',
  'Accessibility to WCAG 2.2 AA',
]

const aiRange = [
  {
    title: 'AI-Free',
    text: 'Hand-written code and hand-made design from start to finish, for teams and projects where AI is off the table.',
  },
  {
    title: 'AI-Assisted',
    text: 'AI where it genuinely helps and nowhere else, with every line reviewed by a person before it ships.',
  },
  {
    title: 'Agentic',
    text: 'Claude Code with agentic automation and workflows that take repeatable work off your plate end to end.',
  },
]
---

<DefaultLayout
  title="About"
  description="Ben Ventures is the design and frontend development practice of Ben Hurley, founder and principal consultant."
>
  <PageHeader title="About" subtitle="Ben Ventures is the design and frontend development practice of Ben Hurley." />

  <section class="section">
    <div class="container split">
      <div>
        <h2>Founder &amp; Principal Consultant</h2>
        <p class="lead">
          I'm a principal consultant for frontend development, UX, design systems and accessibility, with experience at
          some of the world's most prominent companies.
        </p>
        <ul class="expertise">
          {expertise.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="split__art">
        <Image
          src={headshot}
          alt="Ben Hurley"
          class="media-round headshot"
          widths={[240, 400, 576]}
          sizes="(min-width: 768px) 400px, 240px"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>AI-Free to Fully Agentic</h2>
        <p class="lead">
          Every team has its own comfort level with AI, so I meet you where you are: completely AI-free, Claude Code
          with agentic automation and workflows, or anything in between.
        </p>
      </div>
      <ul class="grid">
        {
          aiRange.map((item) => (
            <li>
              <div class="card">
                <h3>{item.title}</h3>
                <p class="muted">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose brand">
        <h2>About the Brand</h2>
        <p>
          The Ben Ventures logo is the HTML bold tag, <code>&lt;b&gt;</code>: b for Ben. The closing bracket doubles as
          a v, so it also reads BV.
        </p>
        <p>
          It's set in magenta, black and cyan, three of the four printing inks, because the work is half code and half
          design.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--closing">
    <div class="container">
      <h2 class="closing">Let's Get to Work.</h2>
      <div class="btn-row">
        <a
          class="btn btn--primary"
          href="mailto:ben@benvent.com?subject=Project%20Inquiry&body=Hi%20Ben%2C%0A%0AI%27d%20like%20to%20discuss%20a%20project.%20Here%27s%20what%20I%27m%20looking%20for%3A%0A%0A"
          >Email Ben</a
        >
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .expertise {
    margin-bottom: 0;
    padding-left: var(--space-5);
  }

  .expertise li + li {
    margin-top: var(--space-2);
  }

  .headshot {
    width: 100%;
    max-width: 25rem;
    height: auto;
  }

  /* The prose column is centred by the kit; on this page it lines up with the sections above */
  .brand {
    margin-inline: 0;
  }

  .closing {
    margin-bottom: var(--space-6);
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
</style>
