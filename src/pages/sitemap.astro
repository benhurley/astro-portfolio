---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { getCollection } from 'astro:content'

// Get all portfolio projects
const projects = (await getCollection('projects')).sort((a, b) => a.data.sortOrder - b.data.sortOrder)

// Define static pages with their descriptions
const staticPages = [
  {
    title: 'Home',
    url: '/',
    description: 'What I do, recent work and how to get in touch.',
  },
  {
    title: 'Portfolio',
    url: '/portfolio/',
    description: 'A collection of design and development projects.',
  },
]
---

<DefaultLayout title="Sitemap" description="Every page and portfolio project on the Ben Ventures website.">
  <PageHeader title="Sitemap" subtitle="Every page and project on this site." />

  <section class="section">
    <div class="container">
      <h2>Main pages</h2>
      <ul class="grid">
        {
          staticPages.map((page) => (
            <li>
              <a class="card" href={page.url}>
                <span class="eyebrow">{page.url}</span>
                <h3>{page.title}</h3>
                <p class="muted">{page.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Portfolio projects</h2>
      <ul class="grid">
        {
          projects.map((project) => (
            <li>
              <a class="card" href={`/portfolio/${project.id}/`}>
                <span class="eyebrow">/portfolio/{project.id}/</span>
                <h3>{project.data.title}</h3>
                <p class="muted">{project.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="muted sitemap-note">
        Search engines use the XML sitemap at <a href="/sitemap-index.xml">/sitemap-index.xml</a>, regenerated on every
        build.
      </p>
    </div>
  </section>
</DefaultLayout>

<style>
  .sitemap-note {
    margin-top: var(--space-7);
  }
</style>
