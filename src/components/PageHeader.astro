---
import { Image } from 'astro:assets'
import sanitizeHtml from 'sanitize-html'

/**
 * PageHeader Component
 *
 * @description Page title block: breadcrumbs, optional banner image, h1 and lead
 */
interface Props {
  /**
   * Additional classes to apply to the PageHeader
   */
  class?: string
  /**
   * The featured image of the page
   */
  featuredImage?: string
  /**
   * The title of the page
   */
  title: string
  /**
   * The subtitle of the page
   * @description Can contain HTML content (will be sanitized)
   */
  subtitle?: string
  /**
   * Eyebrow label above the title
   */
  eyebrow?: string
  /**
   * Whether to show the breadcrumbs
   */
  showBreadcrumbs?: boolean
}

const { class: className, title, subtitle, eyebrow, showBreadcrumbs = true, featuredImage } = Astro.props

// Sanitize subtitle HTML if present
const sanitizedSubtitle: string = subtitle
  ? sanitizeHtml(subtitle, {
      allowedTags: ['b', 'i', 'em', 'strong', 'a', 'span', 'br'],
      allowedAttributes: {
        a: ['href', 'title', 'target', 'rel'],
        span: ['class'],
      },
    })
  : ''

// Breadcrumbs from the URL path; the last segment is the current page
const segments = Astro.url.pathname.split('/').filter(Boolean)
const crumbs = segments.map((segment, index) => ({
  href: `/${segments.slice(0, index + 1).join('/')}/`,
  label: index === segments.length - 1 ? title : segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
  current: index === segments.length - 1,
}))
---

<section class:list={[className, 'page-header']}>
  <div class="container">
    {
      showBreadcrumbs && crumbs.length > 0 && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((crumb) => (
              <li>
                {crumb.current ? (
                  <span aria-current="page">{crumb.label}</span>
                ) : (
                  <a href={crumb.href}>{crumb.label}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {
      featuredImage && (
        <Image
          src={featuredImage}
          alt=""
          width={1200}
          height={250}
          class="page-header__banner asset-outline"
          loading="eager"
        />
      )
    }
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {sanitizedSubtitle && <p class="lead" set:html={sanitizedSubtitle} />}
  </div>
</section>
