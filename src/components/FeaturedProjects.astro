---
import { getCollection } from 'astro:content'
import type { ImageMetadata } from 'astro'
import WorkCard from './WorkCard.astro'

/**
 * FeaturedProjects Component
 *
 * @description A component that displays featured projects from Astro Content Collections
 */
interface Props {
  /**
   * Eyebrow label above the section title
   */
  eyebrow?: string
  /**
   * The number of projects to display
   * @default 3
   */
  limit?: number
  /**
   * The title for the section
   * @default "Selected work"
   */
  title?: string
}

const { eyebrow, limit = 3, title = 'Selected work' } = Astro.props

// Get projects from content collection
const projects = await getCollection('projects')

// Dynamically import all images from the projects folder
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/projects/*.{png,jpg,jpeg,webp}', {
  eager: true,
})

// Filter featured projects and sort them
const featuredProjects = projects
  .filter((project) => project.data.isFeatured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, limit)
  .map((project) => ({
    ...project,
    imageComponent: images[`/src/assets/images/projects/${project.data.featuredImage}`]?.default,
  }))
---

<section class="section">
  <div class="container">
    <div class="section-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
    </div>
    <ul class="grid">
      {
        featuredProjects.map((project) => (
          <li>
            <WorkCard
              href={'/portfolio/' + project.id.replace(/\.mdx?$/, '')}
              title={project.data.title}
              description={project.data.description}
              platform={project.data.platform}
              image={project.imageComponent}
              badge={project.data.badge}
            />
          </li>
        ))
      }
    </ul>
    <div class="section-cta">
      <a class="btn btn--secondary" href="/portfolio/">See more</a>
    </div>
  </div>
</section>
