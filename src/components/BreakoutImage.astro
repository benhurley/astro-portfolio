---
import { Image } from 'astro:assets'

/**
 * BreakoutImage Component
 *
 * @description A component for displaying a landscape image that breaks out of the text measure
 */
interface Props {
  /**
   * The image source
   */
  src: string
  /**
   * The image alt text
   */
  alt: string
}

const { src, alt = '' } = Astro.props
---

<div class="breakout">
  <Image src={src} alt={alt} width={1400} height={700} class="asset-outline" loading="lazy" />
</div>

<style>
  .breakout {
    margin-block: var(--space-7);
  }

  .breakout :global(img) {
    width: 100%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .breakout {
      width: min(calc(100vw - 2 * var(--gutter)), var(--container-max));
    }
  }
</style>
