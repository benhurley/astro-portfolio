---
/**
 * BlockQuote Component
 *
 * @description A pull quote or testimonial with an optional author, avatar and link
 */
interface Props {
  /**
   * The name of the person who said the quote
   */
  author?: string
  /**
   * URL to the author's avatar image
   */
  avatar?: string
  /**
   * Link to the author's website or profile
   */
  link?: string
}

const { author, avatar, link } = Astro.props
---

<figure class="quote">
  <blockquote class="quote__text">
    <slot />
  </blockquote>
  {
    author && (
      <figcaption class="quote__author">
        {avatar && <img src={avatar} alt="" class="quote__avatar media-round" width="48" height="48" loading="lazy" />}
        <cite>
          {link ? (
            <a href={link} target="_blank" rel="noopener noreferrer">
              {author}
            </a>
          ) : (
            author
          )}
        </cite>
      </figcaption>
    )
  }
</figure>

<style>
  cite {
    font-style: normal;
  }
</style>
