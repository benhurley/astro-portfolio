---
import Spot from './Spot.astro'

/**
 * Hero Component
 *
 * @description Home page hero: the "website" spot illustration, the page's one display headline and actions
 */
const heroMessages = [
  "Is your website stuck in 2010? Let's rescue it.",
  'Website looking like MySpace? We should talk.',
]
const randomMessage = heroMessages[Math.floor(Math.random() * heroMessages.length)]
---

<section class="hero bg-grid">
  <div class="container split">
    <div class="hero__art">
      <Spot name="website" decorative />
    </div>
    <div>
      <h1 class="display">{randomMessage}</h1>
      <div class="btn-row">
        <a class="btn btn--primary" href="/portfolio/">See the work</a>
        <a
          class="btn btn--secondary"
          href="mailto:ben@benvent.com?subject=Project%20Inquiry&body=Hi%20Ben%2C%0A%0AI%27d%20like%20to%20discuss%20a%20project.%20Here%27s%20what%20I%27m%20looking%20for%3A%0A%0A"
          >Get in touch</a
        >
      </div>
    </div>
  </div>
</section>

<style>
  .display {
    margin-bottom: var(--space-6);
  }

  /* The illustration accompanies the headline on wider screens only */
  .hero__art {
    display: none;
  }

  .hero__art :global(.spot) {
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    /* Give the headline the wider column so it doesn't stack four lines deep */
    .split {
      grid-template-columns: 2fr 3fr;
    }

    .hero__art {
      display: block;
    }
  }
</style>
