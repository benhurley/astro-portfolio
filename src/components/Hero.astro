---
/**
 * Hero Component
 *
 * @description Home page hero: eyebrow, the page's one display headline, lead and actions
 */
const heroMessages = [
  "Is your website stuck in 2010? Let's rescue it.",
  'Website looking like MySpace? We should talk.',
]
const randomMessage = heroMessages[Math.floor(Math.random() * heroMessages.length)]
---

<section class="hero">
  <div class="container">
    <span class="eyebrow">design &amp; frontend development</span>
    <h1 class="display">{randomMessage}</h1>
    <p class="lead">
      I'll fix your website or build a new one: clean, fast and accessible, from a product engineer trusted by companies
      of all sizes.
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/portfolio/">See the work</a>
      <a
        class="btn btn--secondary"
        href="mailto:ben@benvent.com?subject=Project%20Inquiry&body=Hi%20Ben%2C%0A%0AI%27d%20like%20to%20discuss%20a%20project.%20Here%27s%20what%20I%27m%20looking%20for%3A%0A%0A"
        >Get in touch</a
      >
    </div>
  </div>
</section>

<style>
  .display {
    max-width: 16ch;
  }

  .lead {
    margin-bottom: var(--space-6);
  }
</style>
