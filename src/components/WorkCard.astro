---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

/**
 * WorkCard Component
 *
 * @description A whole-card link to a project, in the kit's order: media slot, eyebrow (platform), title, muted
 * description. The image fills the card's 16:10 media slot and has no frame or shadow of its own.
 */
interface Props {
  href: string
  title: string
  description: string
  platform: string
  image?: ImageMetadata
  /**
   * Heading level for the title; it is always styled at h3 size
   * @default 'h3'
   */
  headingLevel?: 'h2' | 'h3'
}

const { href, title, description, platform, image, headingLevel: Heading = 'h3' } = Astro.props
---

<a class="card" href={href}>
  <div class="card__media">
    {
      image ? (
        <Image src={image} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 400px, 100vw" loading="lazy" />
      ) : (
        <span class="card__placeholder">{title}</span>
      )
    }
  </div>
  <span class="eyebrow">{platform.toLowerCase()}</span>
  <Heading class="work-card__title">{title}</Heading>
  <p class="muted">{description}</p>
</a>
