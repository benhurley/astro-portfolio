---
import external from '../assets/icons/external.inline.svg?raw'

/**
 * LinkIcon Component
 *
 * @description The kit's external-link icon (`.link-icon`, styled in base.css), copied verbatim from the brand kit's
 * web/icons/. Put it after the link text, on the same line inside the <a>: in MDX, text on its own line gets wrapped
 * in a <p> and knocks the icon out of line.
 */
---

<Fragment set:html={external} />
