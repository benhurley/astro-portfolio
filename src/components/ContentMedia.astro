---
import Spot from './Spot.astro'
import BrowserFrame from './BrowserFrame.astro'

/**
 * ContentMedia Component
 *
 * @description A section with content beside a brand spot illustration or an image.
 * - With `spot`: the kit's `.split` (WEB.md §7): text first, the spot beside it from 768px and centred above it on
 *   phones.
 * - With `imgSrc`: the site's `.media-split`, a screenshot beside the text in two equal columns, presented in a
 *   BrowserFrame.
 */
interface Props {
  /**
   * The source URL for an image (use this or `spot`)
   */
  imgSrc?: string
  /**
   * Alt text for the image; decorative by default
   * @default ''
   */
  imgAlt?: string
  /**
   * A brand spot illustration to show instead of an image (decorative: the text beside it carries the meaning)
   */
  spot?: 'advise' | 'coming-soon' | 'legacy-site'
  /**
   * Images only: show the image on the right side instead of the left
   * @default false
   */
  reverseImg?: boolean
}

const { imgSrc, imgAlt = '', spot, reverseImg = false }: Props = Astro.props
---

<section class="section">
  {
    spot ? (
      <div class="container split">
        <div>
          <slot />
        </div>
        <div class="split__art">
          <Spot name={spot} decorative />
        </div>
      </div>
    ) : (
      <div class="container media-split">
        <div class="media-split__media" style={reverseImg ? 'order: 1' : undefined}>
          <BrowserFrame>
            <img src={imgSrc} alt={imgAlt} loading="lazy" decoding="async" />
          </BrowserFrame>
        </div>
        <div>
          <slot />
        </div>
      </div>
    )
  }
</section>
