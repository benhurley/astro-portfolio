---
/**
 * ContentMedia Component
 *
 * @description A section that displays content alongside an image, with the option to reverse the image position
 */
interface Props {
  /**
   * The source URL for the image
   */
  imgSrc: string
  /**
   * Alt text for the image; decorative by default
   * @default ''
   */
  imgAlt?: string
  /**
   * Whether to display the image on the right side instead of the left
   * @default false
   */
  reverseImg?: boolean
}

const { imgSrc, imgAlt = '', reverseImg = false }: Props = Astro.props
---

<section class="section">
  <div class="container split">
    <div class="split__media" style={reverseImg ? 'order: 1' : undefined}>
      <img src={imgSrc} alt={imgAlt} loading="lazy" decoding="async" />
    </div>
    <div>
      <slot />
    </div>
  </div>
</section>
